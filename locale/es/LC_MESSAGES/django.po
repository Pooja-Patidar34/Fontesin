#: .\accounts\forms\company_form.py:459
msgid "Company name is required and cannot be only spaces."
msgstr ""
"El nombre de la empresa es obligatorio y no puede contener solo espacios."

#: .\accounts\forms\company_form.py:461
msgid "Company name must be at least 2 characters."
msgstr "El nombre de la empresa debe tener al menos 2 caracteres."

#: .\accounts\forms\company_form.py:463
msgid "Company name must be 100 characters or fewer."
msgstr "El nombre de la empresa debe tener 100 caracteres o menos."

#: .\accounts\forms\company_form.py:466
msgid ""
"Company name may only contain letters, digits, spaces, and the symbols & "
"' . , - ( ), and must contain at least one letter."
msgstr ""
"El nombre de la empresa solo puede contener letras, dígitos, espacios y los "
"símbolos & '. , - ( ), y debe contener al menos una letra."

#: .\accounts\forms\company_form.py:478 .\accounts\view\profile.py:506
msgid ""
"A company with this name already exists. Please choose a different name."
msgstr "Ya existe una empresa con este nombre. Elija un nombre diferente."

#: .\accounts\forms\company_form.py:488
msgid "Registration ID must be at least 2 characters."
msgstr "El ID de registro debe tener al menos 2 caracteres."

#: .\accounts\forms\company_form.py:490
msgid "Registration ID must be 100 characters or fewer."
msgstr "El ID de registro debe tener 100 caracteres o menos."

#: .\accounts\forms\company_form.py:493
msgid ""
"Registration ID may only contain letters, digits, and the symbols - / . _ , "
"and must contain at least one letter or digit."
msgstr ""
"El ID de registro solo puede contener letras, dígitos y los símbolos - / . _ "
"y debe contener al menos una letra o un dígito."

#: .\accounts\forms\company_form.py:507
msgid ""
"A company with this Registration ID already exists. Registration IDs must be "
"unique."
msgstr ""
"Ya existe una empresa con este ID de registro. Los ID de registro deben ser "
"únicos."

#: .\accounts\forms\company_form.py:530 .\accounts\view\profile.py:615
msgid "State is required."
msgstr "Se requiere estado."

#: .\accounts\forms\company_form.py:534 .\accounts\view\profile.py:619
msgid "Please select a valid state for the chosen country."
msgstr "Seleccione un estado válido para el país elegido."

#: .\accounts\forms\company_form.py:537 .\accounts\view\profile.py:603
#: .\accounts\view\user.py:694
msgid "Country is required."
msgstr "Se requiere país."

#: .\accounts\forms\company_form.py:548
#, python-format
msgid ""
"A company named '%(name)s' already exists in %(country)s. If this is a "
"different legal entity, please provide a Registration ID to distinguish it."
msgstr ""
"Ya existe una empresa llamada '%(name)s' en %(country)s. Si se trata de una "
"entidad jurídica distinta, indique un ID de registro para diferenciarla."

#: .\accounts\forms\company_form.py:560
#, python-format
msgid "%(label)s must be at least 3 characters."
msgstr "%(label)s debe tener al menos 3 caracteres."

#: .\accounts\forms\company_form.py:562
#, python-format
msgid "%(label)s must be 120 characters or fewer."
msgstr "%(label)s debe tener 120 caracteres o menos."

#: .\accounts\forms\company_form.py:565
#, python-format
msgid ""
"%(label)s may only contain letters, digits, spaces and the symbols , . - / "
"#. Other special characters (such as ! @ $ %% ^ * {{ }} [ ] < >) are not "
"allowed."
msgstr ""
"%(label)s solo puede contener letras, dígitos, espacios y los símbolos , . "
"- / #."

#: .\accounts\forms\company_form.py:572
msgid "Address Line 1"
msgstr "Dirección Línea 1"

#: .\accounts\forms\company_form.py:575
msgid "Address Line 2"
msgstr "Línea de dirección 2"

#: .\accounts\forms\company_form.py:582
msgid "Postal code must be at least 3 characters."
msgstr "El código postal debe tener al menos 3 caracteres."

