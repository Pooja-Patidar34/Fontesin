msgctxt "auth.application_pending"
msgid "Your application has been submitted"
msgstr "Ihre Bewerbung wurde eingereicht"

#: templates/auth/application_pending.html
msgctxt "auth.application_pending"
msgid "A super admin is reviewing your details"
msgstr "Ein Superadministrator überprüft Ihre Daten"

#: templates/auth/application_pending.html
msgctxt "auth.application_pending"
msgid "You'll get full dashboard access once approved"
msgstr ""
"Nach der Genehmigung erhalten Sie vollständigen Zugriff auf das Dashboard"

#: templates/auth/application_pending.html
msgctxt "auth.application_pending"
msgid "You'll be notified of the decision"
msgstr "Sie werden über die Entscheidung informiert"

