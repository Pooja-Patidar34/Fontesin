#: templates/auth/verify.html
msgctxt "auth.verify"
msgid ""
"Thanks — we've received your submission. We're confirming your identity with"
" our verification partner. This usually takes a few moments; you'll be taken"
" to the next step automatically once it's done."
msgstr ""
