msgstr ""
"Le nom du locataire ne peut contenir que des lettres, des chiffres, des "
"espaces et les symboles & ' . , - ( ), et doit contenir au moins une lettre."

#: .\accounts\forms\tenant_form.py:56
msgid ""
"A franchise with this name already exists. Please choose a different name."
msgstr ""
