#: .\accounts\forms\company_form.py:88
msgid "Select Country"
msgstr "Sélectionnez un pays"

#: .\accounts\forms\company_form.py:459
msgid "Company name is required and cannot be only spaces."
msgstr ""
"Le nom de l’entreprise est obligatoire et ne peut pas contenir uniquement "
"des espaces."

#: .\accounts\forms\company_form.py:461
msgid "Company name must be at least 2 characters."
msgstr "Le nom de l'entreprise doit comporter au moins 2 caractères."

#: .\accounts\forms\company_form.py:463
msgid "Company name must be 100 characters or fewer."
msgstr "Le nom de l'entreprise doit comporter 100 caractères ou moins."

#: .\accounts\forms\company_form.py:466
msgid ""
"Company name may only contain letters, digits, spaces, and the symbols & ' ."
" , - ( ), and must contain at least one letter."
msgstr ""
"Le nom de l'entreprise ne peut contenir que des lettres, des chiffres, des "
"espaces et les symboles & ' . , - ( ), et doit contenir au moins une lettre."

#: .\accounts\forms\company_form.py:478 .\accounts\view\profile.py:479
msgid ""
"A company with this name already exists. Please choose a different name."
msgstr ""
"Une entreprise portant ce nom existe déjà. Veuillez choisir un autre nom."

#: .\accounts\forms\company_form.py:488
msgid "Registration ID must be at least 2 characters."
msgstr "L’identifiant d’enregistrement doit comporter au moins 2 caractères."

#: .\accounts\forms\company_form.py:490
msgid "Registration ID must be 100 characters or fewer."
msgstr ""
"L’identifiant d’enregistrement doit comporter 100 caractères ou moins."

#: .\accounts\forms\company_form.py:493
msgid ""
"Registration ID may only contain letters, digits, and the symbols - / . _ , "
"and must contain at least one letter or digit."
msgstr ""
"L'ID d'enregistrement ne peut contenir que des lettres, des chiffres et les "
"symboles - / . _ , et doit contenir au moins une lettre ou un chiffre."

#: .\accounts\forms\company_form.py:507
msgid ""
"A company with this Registration ID already exists. Registration IDs must be"
" unique."
msgstr ""
"Une entreprise avec cet identifiant d'enregistrement existe déjà. Les "
"identifiants d’enregistrement doivent être uniques."

#: .\accounts\forms\company_form.py:530 .\accounts\view\profile.py:588
msgid "State is required."
msgstr "L'état est requis."

#: .\accounts\forms\company_form.py:534 .\accounts\view\profile.py:592
msgid "Please select a valid state for the chosen country."
msgstr "Veuillez sélectionner un état valide pour le pays choisi."

#: .\accounts\forms\company_form.py:537 .\accounts\view\profile.py:576
#: .\accounts\view\user.py:659
msgid "Country is required."
msgstr "Le pays est requis."

#: .\accounts\forms\company_form.py:548
#, python-format
msgid ""
"A company named '%(name)s' already exists in %(country)s. If this is a "
"different legal entity, please provide a Registration ID to distinguish it."
msgstr ""

#: .\accounts\forms\company_form.py:560
#, python-format
msgid "%(label)s must be at least 3 characters."
msgstr "%(label)s doit contenir au moins 3 caractères."

#: .\accounts\forms\company_form.py:562
#, python-format
msgid "%(label)s must be 120 characters or fewer."
msgstr "%(label)s doit contenir 120 caractères ou moins."

#: .\accounts\forms\company_form.py:565
#| msgid ""
#| "%(label)s may only contain letters, digits, spaces and the symbols , . - / "
#| "#. "
msgid ""
"%(label)s may only contain letters, digits, spaces and the symbols , . - / "
"#. Other special characters (such as ! @ $ %% ^ * {{ }} [ ] < >) are not "
"allowed."
msgstr ""
"%(label)s ne peut contenir que des lettres, des chiffres, des espaces et les"
" symboles , . -/#."

#: .\accounts\forms\company_form.py:572
msgid "Address Line 1"
msgstr "Adresse Ligne 1"

#: .\accounts\forms\company_form.py:575
msgid "Address Line 2"
msgstr "Ligne d'adresse 2"

#: .\accounts\forms\company_form.py:582
msgid "Postal code must be at least 3 characters."
msgstr "Le code postal doit comporter au moins 3 caractères."

#: .\accounts\forms\company_form.py:584
msgid "Postal code must be 12 characters or fewer."
msgstr "Le code postal doit comporter 12 caractères ou moins."

#: .\accounts\forms\company_form.py:587
msgid ""
"Postal code may only contain letters, digits, spaces and hyphens, and must "
"contain at least one letter or digit."
msgstr ""
"Le code postal ne peut contenir que des lettres, des chiffres, des espaces "
"et des traits d'union, et doit contenir au moins une lettre ou un chiffre."

#: .\accounts\forms\company_form.py:596
msgid "City must be at least 2 characters."
msgstr "La ville doit comporter au moins 2 caractères."

#: .\accounts\forms\company_form.py:598
msgid "City must be 60 characters or fewer."
msgstr "La ville doit comporter 60 caractères ou moins."

#: .\accounts\forms\company_form.py:601
msgid ""
"City may only contain letters, spaces, hyphens, apostrophes and periods. "
"Numbers and special characters are not allowed."
msgstr ""
"La ville ne peut contenir que des lettres, des espaces, des traits d'union, "
"des apostrophes et des points. Les chiffres et les caractères spéciaux ne "
"sont pas autorisés."

#: .\accounts\forms\company_form.py:624
#, python-format
msgid ""
"%(label)s may only contain digits and the symbols + - ( ) and spaces (7-25 "
"characters)."
msgstr ""
"%(label)s ne peut contenir que des chiffres et les symboles + - ( ) et des "
"espaces (7 à 25 caractères)."

#: .\accounts\forms\company_form.py:646
#, python-format
msgid "%(label)s must be %(min)s-%(max)s digits for the selected country."
msgstr ""
"%(label)s doit être composé de %(min)s-%(max)s chiffres pour le pays "
"sélectionné."

#: .\accounts\forms\company_form.py:653
#, python-format
msgid "%(label)s must contain 5-15 digits."
msgstr "%(label)s doit contenir 5 à 15 chiffres."

#: .\accounts\forms\company_form.py:658 .\accounts\view\auth.py:225
msgid "Phone"
msgstr "Téléphone"

#: .\accounts\forms\company_form.py:661
msgid "Secondary phone"
msgstr "Téléphone secondaire"

#: .\accounts\forms\company_form.py:669
msgid ""
"Fax may only contain digits and the symbols + - ( ) and spaces (7-25 "
"characters)."
msgstr ""
"Le fax ne peut contenir que des chiffres et les symboles + - ( ) et des "
"espaces (7 à 25 caractères)."

#: .\accounts\forms\company_form.py:673
msgid "Fax number must contain 5-15 digits."
msgstr "Le numéro de fax doit contenir 5 à 15 chiffres."

#: .\accounts\forms\company_form.py:682
#, python-format
msgid "%(label)s must be %(max)s characters or fewer."
msgstr "%(label)s doit contenir %(max)s caractères ou moins."

#: .\accounts\forms\company_form.py:686
#, python-format
msgid "%(label)s contains invalid characters."
msgstr "%(label)s contient des caractères non valides."

#: .\accounts\forms\company_form.py:691
msgid "House number"
msgstr "Numéro de maison"

#: .\accounts\forms\company_form.py:694
msgid "District"
msgstr "District"

#: .\accounts\forms\company_form.py:697
msgid "Region"
msgstr "Région"

#: .\accounts\forms\company_form.py:705 .\accounts\view\profile.py:645
msgid ""
"Industry code may only contain letters, digits, dots and hyphens (1-20 "
"characters)."
msgstr ""
"Le code de l'industrie ne peut contenir que des lettres, des chiffres, des "
"points et des traits d'union (1 à 20 caractères)."

#: .\accounts\forms\company_form.py:714 .\accounts\view\profile.py:651
msgid "Keywords must be 500 characters or fewer."
msgstr "Les mots clés doivent comporter 500 caractères ou moins."

#: .\accounts\forms\company_form.py:724
#, python-format
msgid "Year of establishment must be between 1500 and %(year)s."
msgstr "L’année d’établissement doit être comprise entre 1500 et %(year)s."

#: .\accounts\forms\company_form.py:734
msgid "Name must be at least 2 characters."
msgstr "Le nom doit comporter au moins 2 caractères."

#: .\accounts\forms\company_form.py:736
msgid "Name must be 80 characters or fewer."
msgstr "Le nom doit comporter 80 caractères maximum."

#: .\accounts\forms\company_form.py:739
msgid "Use letters, spaces, hyphens, apostrophes, or dots only."
msgstr ""
"Utilisez uniquement des lettres, des espaces, des traits d’union, des "
"apostrophes ou des points."

#: .\accounts\forms\company_form.py:773
#, python-format
msgid "Logo must be one of: %(exts)s"
msgstr "Le logo doit être l'un des suivants : %(exts)s"

#: .\accounts\forms\company_form.py:777 .\accounts\view\profile.py:670
msgid "Logo file must be 5 MB or smaller."
msgstr "Le fichier du logo doit faire 5 Mo ou moins."

#: .\accounts\forms\company_form.py:785
msgid "Website URL must be 500 characters or fewer."
msgstr "L'URL du site Web doit comporter 500 caractères ou moins."

#: .\accounts\forms\company_form.py:788
#| msgid ""
#| "Enter a valid website URL like https://example.com (only letters, digits, "
#| "and - . _ / in the path)."
msgid ""
"Enter a valid website URL like https://example.com. Only letters, digits, "
"and - . _ / are allowed in the path."
msgstr ""
"Saisissez une URL de site Web valide telle que https://example.com "
"(uniquement des lettres, des chiffres et - . _ / dans le chemin)."

#: .\accounts\forms\tenant_form.py:40
msgid "Tenant name must be at least 2 characters."
msgstr "Le nom du locataire doit comporter au moins 2 caractères."

#: .\accounts\forms\tenant_form.py:42
msgid "Tenant name must be 100 characters or fewer."
msgstr "Le nom du locataire doit comporter 100 caractères maximum."

#: .\accounts\forms\tenant_form.py:45
msgid ""
"Tenant name may only contain letters, digits, spaces, and the symbols & ' . "
